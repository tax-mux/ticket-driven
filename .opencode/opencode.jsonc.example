{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen/qwen3.6-35b-a3b",
  "instructions": [
    "$HOME/.config/opencode/cursor-user-rules.md",
    "$HOME/.config/opencode/init-bootstrap.md"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      // models.dev が自動投入する未DLモデルを候補から除外し、
      // LM Studio にダウンロード済みのものだけを表示する
      "whitelist": [
        "google/gemma-4-12b-qat",
        "google/gemma-4-26b-a4b-qat",
        "qwen/qwen3.6-35b-a3b",
        "qwen/qwen3.6-27b"
      ],
      "models": {
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B QAT (local)"
        },
        "google/gemma-4-26b-a4b-qat": {
          "name": "Gemma 4 26B A4B QAT (local)"
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B (local)"
        },
        "qwen/qwen3.6-27b": {
          "name": "Qwen3.6 27B (local)"
        }
      }
    }
  },
  "skills": [
    {
      "name": "ticket-driven",
      "description": "チケット駆動開発の全体ワークフロー。Redmine チケットを起点に開発タスクを駆動する。",
      "path": "./skills/ticket-driven/SKILL.md"
    },
    {
      "name": "ticket-create",
      "description": "Redmine に新しいチケットを作成する。必須/任意フィールド、種別別テンプレート付き。",
      "path": "./skills/ticket-create/SKILL.md"
    },
    {
      "name": "ticket-list",
      "description": "条件に合う Redmine チケットを取得する。ステータス/担当者/トラッカー別フィルタ、ページネーション対応。",
      "path": "./skills/ticket-list/SKILL.md"
    },
    {
      "name": "ticket-refine",
      "description": "Redmine チケットの内容を精緻化し、開発可能な状態に整える。要件分解・完了条件明確化。",
      "path": "./skills/ticket-refine/SKILL.md"
    },
    {
      "name": "ticket-relation",
      "description": "Redmine チケット間の依存関係・関連付けを管理する。関連種別追加・削除・一覧取得。",
      "path": "./skills/ticket-relation/SKILL.md"
    },
    {
      "name": "ticket-split",
      "description": "親チケットを子チケットに分割し、作業を細分化する。分割方針・テンプレート・関連付け手順付き。",
      "path": "./skills/ticket-split/SKILL.md"
    },
    {
      "name": "ticket-status",
      "description": "チケットのステータスに応じた対応手順。ステータス別アクションと優先度別対応を含む。",
      "path": "./skills/ticket-status/SKILL.md"
    },
    {
      "name": "ticket-update",
      "description": "既存 Redmine チケットの状態・情報を更新する。進捗率・担当者・ステータス変更を含む。",
      "path": "./skills/ticket-update/SKILL.md"
    },
    {
      "name": "git-commit",
      "description": "Git コミット。コミットメッセージ生成、ステージング、hooks 対応。",
      "path": "./skills/git-commit/SKILL.md"
    },
    {
      "name": "git-pr",
      "description": "PR 作成。gh cliまたはGitBucket API対応。diff 確認、タイトル/本文生成、本文生成必須。",
      "path": "./skills/git-pr/SKILL.md"
    },
    {
      "name": "git-branch",
      "description": "ブランチ操作。分岐、マージ、名付け規則。",
      "path": "./skills/git-branch/SKILL.md"
    },
    {
      "name": "git-rebase",
      "description": "リベース操作。衝突解決、interactive リベース。",
      "path": "./skills/git-rebase/SKILL.md"
    },
    {
      "name": "git-diff",
      "description": "diff 確認・レビュー支援。",
      "path": "./skills/git-diff/SKILL.md"
    },
    {
      "name": "git-log",
      "description": "ログ検索・コミット履歴取得。",
      "path": "./skills/git-log/SKILL.md"
    }
  ],
  "mcp": {
    "redmine": {
      "type": "local",
      "command": ["npx", "-y", "@pavelsmith/redmine-mcp"],
      "enabled": true,
      "environment": {
        "REDMINE_URL": "http://127.0.0.1:3000",
        "REDMINE_API_KEY": "REPLACE_WITH_REDMINE_API_KEY"
      }
    },
    "telospvl": {
      "type": "remote",
      "url": "https://{telospvl-host}/sse",
      "enabled": true,
      "oauth": false,
      "headers": {
        "X-API-KEY": "REPLACE_WITH_TELOSPVL_API_KEY"
      }
    },
    "mempalace": {
      "type": "local",
      "command": ["$HOME/.local/bin/mempalace-mcp"],
      "args": ["--palace", "$HOME/.mempalace/palace"],
      "enabled": true
    }
  }
}
