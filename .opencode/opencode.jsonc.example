{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen/qwen3.6-35b-a3b",
  "instructions": [
    // マシン固有: 実パスに置き換える（例: /Users/<you>/.config/opencode/...）
    "$HOME/.config/opencode/cursor-user-rules.md",
    "$HOME/.config/opencode/init-bootstrap.md"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      // models.dev が自動投入する未DLモデルを候補から除外し、
      // LM Studio にダウンロード済みのものだけを表示する
      "whitelist": [
        "google/gemma-4-12b-qat",
        "google/gemma-4-26b-a4b-qat",
        "qwen/qwen3.6-35b-a3b",
        "qwen/qwen3.6-27b"
      ],
      "models": {
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B QAT (local)"
        },
        "google/gemma-4-26b-a4b-qat": {
          "name": "Gemma 4 26B A4B QAT (local)"
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B (local)"
        },
        "qwen/qwen3.6-27b": {
          "name": "Qwen3.6 27B (local)"
        }
      }
    }
  },
  // OpenCode は skills/*/SKILL.md を自動スキャンする。
  // paths は追加のスキル親ディレクトリ（正本: リポジトリルートの skills/）。
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "mcp": {
    "redmine": {
      "type": "local",
      "command": ["npx", "-y", "@pavelsmith/redmine-mcp"],
      "enabled": true,
      "environment": {
        "REDMINE_URL": "http://127.0.0.1:3000",
        "REDMINE_API_KEY": "REPLACE_WITH_REDMINE_API_KEY"
      }
    },
    "telospvl": {
      "type": "remote",
      "url": "https://{telospvl-host}/sse",
      "enabled": true,
      "oauth": false,
      "headers": {
        "X-API-KEY": "REPLACE_WITH_TELOSPVL_API_KEY"
      }
    },
    "mempalace": {
      "type": "local",
      // PATH 上のバイナリ、または絶対パスに置換
      "command": ["mempalace-mcp"],
      "args": ["--palace", "$HOME/.mempalace/palace"],
      "enabled": true
    }
  }
}
